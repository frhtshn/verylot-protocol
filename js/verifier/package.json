{
  "name": "@verylot/verifier",
  "version": "1.0.0",
  "description": "Independent verifier for Verylot provably fair digits (protocol v1)",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/frhtshn/verylot-protocol.git", "directory": "js/verifier" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "verylot-verify": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "build": "tsc --emitDeclarationOnly && node build.mjs",
    "verify": "node dist/cli.js"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "drand-client": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
